; Open this file in Godot 4.6.3 or newer, then press F6/F5 to play.
config_version=5

[application]
config/name="Pfotenstube"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Dein kleines 2D-Haustierglück. Tiere pflegen, adoptieren und ihr Zuhause gestalten."
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Pfotenstube"

[display]
window/size/viewport_width=1280
window/size/viewport_height=860
window/size/window_width_override=1280
window/size/window_height_override=860
window/size/min_width=960
window/size/min_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.965, 0.969, 0.945, 1)

[audio]
driver/enable_input=false
